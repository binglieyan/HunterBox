<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="HunterBox.App.ModelEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MOD文件修改(取消启用MOD才能修改)"
    PrimaryButtonText="确定"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick">

    <ContentDialog.Resources>
        <!-- 目标模型面板挂在 Flyout 上：去掉默认内边距与宽度上限，面板自带 520 宽与 12 内边距。 -->
        <Style x:Key="ModelPickerPresenterStyle" TargetType="FlyoutPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="720" />
            <Setter Property="MaxHeight" Value="640" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel MinWidth="720" Spacing="8">
        <!-- 「MOD名字」只读行 -->
        <Grid x:Name="ModNameRow" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="MOD名字" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="ModNameText" Grid.Column="1" Text="—" IsReadOnly="True" IsTabStop="False"
                     VerticalAlignment="Center" MaxWidth="600" HorizontalAlignment="Left" MinWidth="420" />
        </Grid>

        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- 标题行一行排开 -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <TextBlock Grid.Column="0" Text="模型列表" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="【部分MOD修改会显示异常】" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <CheckBox x:Name="FilterBox" Grid.Column="2" Content="仅显示未使用的ID"
                      VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed" />
        </Grid>

        <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RowsPanel" Spacing="6" />
        </ScrollViewer>

        <TextBlock x:Name="EmptyText" Text="这个MOD没什么模型可以修改"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
    </StackPanel>
</ContentDialog>
