<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HunterBox.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="HunterBox">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- 布局见 docs/SPEC.md §6：顶部信息栏 / 左侧列表 + 右侧按钮列 / 底部状态 -->
    <Grid x:Name="Root" Padding="20,14" RowDefinitions="Auto,*,Auto" RowSpacing="10">

        <!-- 顶部：品牌 + 游戏选择 + 游戏路径 + 刷新（游戏路径在「游戏设置」里修改） -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="HunterBox" Style="{StaticResource TitleTextBlockStyle}" />
                <ComboBox x:Name="GameCombo" MinWidth="180" VerticalAlignment="Center"
                          IsEnabled="{x:Bind ViewModel.CanUseGlobalActions, Mode=OneWay}"
                          SelectionChanged="GameCombo_SelectionChanged" />
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0"
                       Text="{x:Bind ViewModel.GamePathText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="刷新" MinWidth="80"
                        IsEnabled="{x:Bind ViewModel.CanUseGlobalActions, Mode=OneWay}"
                        Click="Refresh_Click" ToolTipService.ToolTip="重新扫描当前游戏的 MOD 列表" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="6">
                <!-- 列头 6 列，与行模板使用同一列网格（勾选列无标题，与 B 一致）。 -->
                <Border Grid.Row="0" Padding="12,8" CornerRadius="4"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid ColumnDefinitions="40,52,*,220,120,110,110" ColumnSpacing="10">
                        <TextBlock Grid.Column="1" Text="顺序" Style="{StaticResource ListHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="MOD名字" Style="{StaticResource ListHeaderTextStyle}" />
                        <TextBlock Grid.Column="3" Text="备注信息" Style="{StaticResource ListHeaderTextStyle}" />
                        <TextBlock Grid.Column="4" Text="分类" Style="{StaticResource ListHeaderTextStyle}" />
                        <TextBlock Grid.Column="5" Text="当前版本" Style="{StaticResource ListHeaderTextStyle}" />
                        <TextBlock Grid.Column="6" Text="NexusMods" Style="{StaticResource ListHeaderTextStyle}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" CornerRadius="4" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <ListView x:Name="ModsList" SelectionMode="Extended"
                              IsEnabled="{x:Bind ViewModel.CanUseGlobalActions, Mode=OneWay}"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              AllowDrop="True" DragOver="ModsList_DragOver" Drop="ModsList_Drop"
                              SelectionChanged="ModsList_SelectionChanged"
                              RightTapped="ModsList_RightTapped">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="{StaticResource ModListRowMinHeight}" />
                                <Setter Property="FontSize" Value="13" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="{StaticResource ModListRowPadding}" ColumnDefinitions="40,52,*,220,120,110,110" ColumnSpacing="10"
                                      ToolTipService.ToolTip="{Binding ToolTipText}">
                                    <!-- 勾选状态由数据决定（原生 CheckBox 在虚拟化列表里偶发不刷新，改用无状态的勾选字形按钮）。 -->
                                    <Button Grid.Column="0" MinWidth="0" MinHeight="0" Padding="0"
                                            Background="Transparent" BorderThickness="0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Click="RowEnable_Click"
                                            ToolTipService.ToolTip="勾选启用，取消勾选禁用"
                                            AutomationProperties.Name="启用或禁用MOD">
                                        <TextBlock Text="{Binding EnabledGlyph, Mode=OneWay}"
                                                   FontFamily="Segoe UI Symbol" FontSize="16"
                                                   VerticalAlignment="Center" />
                                    </Button>
                                    <TextBlock Grid.Column="1" Text="{Binding Index}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <!-- /备注信息列 = 运行时模型信息（模型名/完整 ID/[pfb]/[pak]），无模型时回退用户描述。 -->
                                    <TextBlock Grid.Column="3" Text="{Binding ModelText}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding ModelText}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Category}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="5" Text="{Binding Version}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="6" Text="{Binding NexusId}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

            <!-- 右侧按钮列（窗口缩到最小时滚动兜底）。 -->
            <ScrollViewer Grid.Column="1" Width="172" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="6">
                <Button Content="游戏设置" HorizontalAlignment="Stretch" MinHeight="34"
                        IsEnabled="{x:Bind ViewModel.CanUseGlobalActions, Mode=OneWay}" Click="Settings_Click"
                        ToolTipService.ToolTip="设置游戏路径和存档路径"
                        ToolTipService.Placement="Top" />

                <Border Height="1" Margin="0,1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <TextBlock Text="过滤/位置" Margin="4,0,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="FilterBox" PlaceholderText="关键词"
                         Text="{x:Bind ViewModel.FilterKeyword, Mode=TwoWay}"
                         IsEnabled="{x:Bind ViewModel.CanUseGlobalActions, Mode=OneWay}"
                         TextChanged="FilterBox_TextChanged" KeyDown="FilterBox_KeyDown" />
                <TextBlock Margin="4,0,0,0"
                           Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="搜索" HorizontalAlignment="Stretch" MinHeight="34"
                        IsEnabled="{x:Bind ViewModel.CanUseGlobalActions, Mode=OneWay}" Click="Search_Click"
                        ToolTipService.ToolTip="需要取消过滤，需要清空输入框，再点击搜索" />

                <Button Content="快速移动" HorizontalAlignment="Stretch" MinHeight="34"
                        IsEnabled="{x:Bind ViewModel.CanUseSelectedActions, Mode=OneWay}" Click="MoveTo_Click"
                        ToolTipService.ToolTip="把选中的 MOD 移动到指定位置" />
                <Button Content="添加MOD" HorizontalAlignment="Stretch" MinHeight="34"
                        IsEnabled="{x:Bind ViewModel.CanUseGlobalActions, Mode=OneWay}" Click="Install_Click"
                        ToolTipService.ToolTip="可以把文件拖到MOD列表直接弹出安装界面；把MOD文件夹拖到列表可直接修改模型ID" />
                <Button Content="重装MOD" HorizontalAlignment="Stretch" MinHeight="34"
                        IsEnabled="{x:Bind ViewModel.CanUseSelectedActions, Mode=OneWay}" Click="Reinstall_Click"
                        ToolTipService.ToolTip="重新安装MOD，可以取消不影响" />
                <Button Content="用新包更新" HorizontalAlignment="Stretch" MinHeight="34"
                        IsEnabled="{x:Bind ViewModel.CanUseSelectedActions, Mode=OneWay}" Click="UpdateMod_Click"
                        ToolTipService.ToolTip="选择一个新压缩包，替换当前选中 MOD 的文件（保留序号）" />
                <Button Content="卸载MOD" HorizontalAlignment="Stretch" MinHeight="34"
                        IsEnabled="{x:Bind ViewModel.CanUseSelectedActions, Mode=OneWay}" Click="Uninstall_Click"
                        ToolTipService.ToolTip="需要先停用MOD，再卸载" />

                <Border Height="1" Margin="0,1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Button Content="上移" HorizontalAlignment="Stretch" MinHeight="34"
                        IsEnabled="{x:Bind ViewModel.CanUseSelectedActions, Mode=OneWay}" Click="MoveUp_Click"
                        ToolTipService.ToolTip="把选中的 MOD 向上移动一位" />
                <Button Content="下移" HorizontalAlignment="Stretch" MinHeight="34"
                        IsEnabled="{x:Bind ViewModel.CanUseSelectedActions, Mode=OneWay}" Click="MoveDown_Click"
                        ToolTipService.ToolTip="把选中的 MOD 向下移动一位" />

                <Border Height="1" Margin="0,1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Button Content="启用选中MOD" HorizontalAlignment="Stretch"
                        MinHeight="34" IsEnabled="{x:Bind ViewModel.CanUseSelectedActions, Mode=OneWay}"
                        Click="EnableSelected_Click"
                        ToolTipService.ToolTip="按照顺序启用选择的MOD，默认覆盖冲突" />
                <Button Content="禁用全部MOD" HorizontalAlignment="Stretch" MinHeight="34"
                        IsEnabled="{x:Bind ViewModel.CanUseListActions, Mode=OneWay}" Click="DisableAll_Click"
                        ToolTipService.ToolTip="取消全部已经启用的MOD" />
                <Button Content="删除全部MOD文件" HorizontalAlignment="Stretch"
                        MinHeight="34" IsEnabled="{x:Bind ViewModel.CanUseGlobalActions, Mode=OneWay}"
                        Click="Cleanup_Click"
                        ToolTipService.ToolTip="不改变MOD的启用状态，删除游戏目录对应的MOD文件" />
                <Button Content="重新复制MOD" HorizontalAlignment="Stretch" MinHeight="34"
                        IsEnabled="{x:Bind ViewModel.CanUseListActions, Mode=OneWay}" Click="Recopy_Click"
                        ToolTipService.ToolTip="如果游戏目录的pak的数字已经变更，HunterBox也会自动把pak和mod关联" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="12">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="4,0,0,0"
                       Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="存档" MinWidth="90" MinHeight="34"
                    IsEnabled="{x:Bind ViewModel.CanUseGlobalActions, Mode=OneWay}"
                    VerticalAlignment="Center" Click="Save_Click" />
            <Button Grid.Column="2" Content="启动游戏(Steam)" MinWidth="140" MinHeight="34"
                    IsEnabled="{x:Bind ViewModel.CanUseGlobalActions, Mode=OneWay}"
                    VerticalAlignment="Center" Click="StartGame_Click" />
            <ProgressRing Grid.Column="3" Width="24" Height="24"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          VerticalAlignment="Center" />
            <!-- /：忙碌时显示的协作取消按钮（在下一个安全点生效）。 -->
            <Button Grid.Column="4" Content="取消" MinWidth="72" MinHeight="34"
                    IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.CancelVisibility, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Click="CancelOperation_Click"
                    ToolTipService.ToolTip="请求取消当前操作（已完成的部分会保留，未处理部分保持原状）" />
        </Grid>
    </Grid>
</Window>
