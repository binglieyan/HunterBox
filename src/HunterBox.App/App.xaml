<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="HunterBox.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- WinUI 默认 ContentDialog 最大宽度约 548 DIP，安装/模型编辑等宽内容会被水平裁切。 -->
            <x:Double x:Key="ContentDialogMaxWidth">920</x:Double>

            <!-- /：列表紧凑密度资源。行高 32 DIP，行内不再额外加纵向内边距（勾选框自身 32 高即行高）。 -->
            <x:Double x:Key="ModListRowMinHeight">32</x:Double>
            <Thickness x:Key="ModListRowPadding">12,0</Thickness>

            <!-- /：列表表头统一 13px 半粗 + 次要前景色，浅色/深色都由主题资源决定。 -->
            <Style x:Key="ListHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--：对话框内文字层级（章节标题 / 次要说明），统一字号与次要前景，避免各对话框各写一套。 -->
            <Style x:Key="DialogSectionHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,6,0,0" />
            </Style>
            <Style x:Key="DialogHintTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
