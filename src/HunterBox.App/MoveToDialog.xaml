<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="HunterBox.App.MoveToDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="快速移动"
    PrimaryButtonText="确定"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <!-- 对齐的 MoveToDialog：NumberBox 只允许 1..N，默认当前位。 -->
    <StackPanel MinWidth="320" Spacing="10">
        <TextBlock x:Name="HintText" TextWrapping="Wrap" />
        <NumberBox x:Name="PositionBox" Header="目标位置" Minimum="1"
                   SpinButtonPlacementMode="Compact" />
    </StackPanel>
</ContentDialog>
