<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="HunterBox.App.InstallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="安装 MOD"
    PrimaryButtonText="安装"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    Closing="OnClosing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" MaxHeight="520" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel MinWidth="720" Spacing="12">
                <InfoBar x:Name="WarningBar" Severity="Warning" IsOpen="False" IsClosable="False" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image x:Name="PreviewImage" Grid.Column="0" MaxHeight="220" MaxWidth="220"
                           Stretch="Uniform" Visibility="Collapsed" />
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBox x:Name="NameBox" Header="MOD 名称（必填）" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <TextBox x:Name="CategoryBox" Grid.Column="0" Header="分类" />
                            <TextBox x:Name="VersionBox" Grid.Column="1" Header="版本" />
                            <TextBox x:Name="NexusBox" Grid.Column="2" Header="NexusId" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <TextBox x:Name="AuthorBox" Grid.Column="0" Header="作者" />
                            <TextBox x:Name="HomeUrlBox" Grid.Column="1" Header="MOD 来源（网址）" />
                        </Grid>
                        <TextBox x:Name="DescriptionBox" Header="描述" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="56" MaxHeight="96" />
                        <TextBlock x:Name="SummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- FOMOD/多组件包：可在「按分组」与「手动选文件」之间切换。 -->
                <ToggleSwitch x:Name="ManualSwitch" Visibility="Collapsed"
                              OffContent="按分组/向导安装" OnContent="手动选择文件"
                              Toggled="ManualSwitch_Toggled" />

                <ComboBox x:Name="VariantBox" Visibility="Collapsed" HorizontalAlignment="Stretch"
                          Header="选择变体（该包包含多套安装，本轮保持单选）"
                          SelectionChanged="VariantBox_SelectionChanged" />

                <!-- FOMOD / 多组件包：按安装步骤分组，可折叠。 -->
                <StackPanel x:Name="GroupsPanel" Spacing="8" Visibility="Collapsed" />

                <!-- 普通包 / 手动模式：文件树 + 多根 + 前缀。 -->
                <StackPanel x:Name="ManualPanel" Spacing="8">
                    <TextBlock Text="勾选要安装的文件；可选中多个目录点「设为根」，安装时以这些目录为相对根（根外文件不安装）。"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TreeView x:Name="FileTree" MinHeight="140" MaxHeight="260" SelectionMode="Single">
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <CheckBox MinWidth="0" Padding="0"
                                              IsChecked="{Binding Content.IsChecked, Mode=TwoWay}" />
                                    <TextBlock Text="{Binding Content.DisplayName}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Content="设为根" Click="SetRoot_Click" />
                        <Button Grid.Column="1" Content="取消设置根" Click="UnsetRoot_Click" />
                        <Button Grid.Column="2" Content="恢复全部" Click="ResetRoot_Click" />
                        <TextBlock x:Name="RootText" Grid.Column="3" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </Grid>
                    <TextBox x:Name="PrefixBox" Header="安装前缀（留空或 / 表示根目录）" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部行固定在滚动区外：修复「全选/全不选/已选 x/y」被纵向裁切。 -->
        <StackPanel Grid.Row="1" Spacing="6" Padding="0,8,0,0">
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False" />
            <StackPanel x:Name="ManualActionBar" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <Button Content="全选" Click="SelectAll_Click" />
                <Button Content="全不选" Click="SelectNone_Click" />
                <TextBlock x:Name="CountText" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- 取消确认用对话框内浮层（ContentDialog 内不能再开第二个对话框）；不加蒙版、面板不透明。 -->
        <Grid x:Name="ConfirmOverlay" Grid.RowSpan="2" Background="Transparent" Visibility="Collapsed">
            <Border Background="{ThemeResource ContentDialogBackground}"
                    BorderBrush="{ThemeResource ContentDialogBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12" MaxWidth="420">
                    <TextBlock Text="确定取消安装？" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="已解压的安装包会被丢弃，需要重新选择安装包。" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="继续安装" Click="ConfirmContinue_Click" />
                        <Button Content="放弃安装" Click="ConfirmDiscard_Click"
                                Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ContentDialog>
