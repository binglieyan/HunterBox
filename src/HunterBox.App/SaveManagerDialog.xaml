<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="HunterBox.App.SaveManagerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="存档管理"
    CloseButtonText="关闭"
    DefaultButton="Close"
    Closing="OnDialogClosing">

    <!-- 对齐SaveManagerDialog：名称/时间/大小三列、倒序、恢复/删除前内联二次确认。
         旧存档 zip 通过内联「导入旧存档 zip」面板导入。 -->
    <Grid MinWidth="640" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10">
        <TextBlock x:Name="PathText" Grid.Row="0" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
            <Button x:Name="BackupButton" Grid.Column="0" Content="备份当前存档" Click="Backup_Click" />
            <Button x:Name="RestoreButton" Grid.Column="1" Content="恢复" Click="Restore_Click" IsEnabled="False" />
            <Button x:Name="RenameButton" Grid.Column="2" Content="重命名" Click="Rename_Click" IsEnabled="False" />
            <Button x:Name="DeleteButton" Grid.Column="3" Content="删除" Click="Delete_Click" IsEnabled="False" />
            <Button x:Name="OpenFolderButton" Grid.Column="4" Content="打开目录" Click="OpenFolder_Click" />
            <Button x:Name="ImportLegacyButton" Grid.Column="5" Content="导入旧存档 zip" Click="ImportLegacy_Click"
                    Visibility="Collapsed" />
            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Border x:Name="ConfirmPanel" Grid.Row="2" Visibility="Collapsed" Padding="12" CornerRadius="4"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <StackPanel Spacing="8">
                <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="确定" Click="ConfirmYes_Click" />
                    <Button Content="取消" Click="ConfirmNo_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="RenamePanel" Grid.Row="3" Visibility="Collapsed" Padding="12" CornerRadius="4"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <StackPanel Spacing="8">
                <TextBox x:Name="RenameBox" Header="新名称"
                         PlaceholderText="例如：狩猎前 / 20260101-120000" KeyDown="RenameBox_KeyDown" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="确定" Click="RenameOk_Click" />
                    <Button Content="取消" Click="RenameCancel_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="ImportPanel" Grid.Row="4" Visibility="Collapsed" Padding="12" CornerRadius="4"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <StackPanel Spacing="8">
                <TextBlock x:Name="LegacyHintText" TextWrapping="Wrap" />
                <ComboBox x:Name="LegacyCombo" HorizontalAlignment="Stretch"
                          PlaceholderText="选择要导入的旧存档 zip" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ImportConfirmButton" Content="导入" Click="ImportConfirm_Click" />
                    <Button Content="取消" Click="ImportCancel_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="5" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Padding="12,6" CornerRadius="4"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                <Grid ColumnDefinitions="*,150,100" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="名称" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="时间" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="大小" FontWeight="SemiBold" />
                </Grid>
            </Border>
            <ListView x:Name="SavesList" Grid.Row="1" Height="300" SelectionMode="Single"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectionChanged="SavesList_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="32" />
                        <Setter Property="FontSize" Value="13" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,4" ColumnDefinitions="*,150,100" ColumnSpacing="8"
                              ToolTipService.ToolTip="{Binding Name}">
                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyText" Grid.Row="1" IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="还没有存档备份。&#x0a;点击「备份当前存档」创建第一个备份，或「导入旧存档 zip」迁移旧存档。" />
        </Grid>
    </Grid>
</ContentDialog>
